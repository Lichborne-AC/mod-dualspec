[worldserver]

#####################################################
# Dual Spec Command Module
#####################################################
#
#    DualSpec.Enable
#        Description: Enable or disable the .dualspec player command,
#                     which unlocks Dual Talent Specialization for the
#                     calling character. Requires level 10
#        Default:     1 - Enabled
#                     0 - Disabled
#

DualSpec.Enable = 1
